APP_NAME=WhiteBearDataAgent
APP_ENV=development
TIMEZONE=Asia/Shanghai

# Leave these empty to run health checks and the setup page without PostgreSQL.
# Runtime credentials: separate application and read-only business accounts.
APP_DATABASE_URL=
BUSINESS_READONLY_DATABASE_URL=

# CLI only: existing PostgreSQL administrator and business database owner.
# db init requires all four URLs to use different accounts on the same instance.
ADMIN_DATABASE_URL=
BUSINESS_DATABASE_URL=

QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Per-call model budgets in seconds. Raise the summary budget if summaries time out.
# Keep the worst case (3x query + summary) under the 300s frontend stream wait.
# LLM_QUERY_TIMEOUT_SECONDS=60
# LLM_SUMMARY_TIMEOUT_SECONDS=90

# Optional absolute path; defaults to ../frontend/dist relative to backend/.
# FRONTEND_DIST=
