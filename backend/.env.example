APP_NAME=WhiteBearDataAgent
APP_ENV=development
TIMEZONE=Asia/Shanghai

# Leave these empty to run the scaffold without PostgreSQL or a model API key.
# Use separate application and read-only business accounts when configuring databases.
APP_DATABASE_URL=
BUSINESS_DATABASE_URL=

QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Optional absolute path; defaults to ../frontend/dist relative to backend/.
# FRONTEND_DIST=
